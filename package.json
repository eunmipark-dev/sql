{
  "name": "sql-cert",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "predev": "node scripts/build-exam-index.mjs && node scripts/check-lectures.mjs",
    "dev": "vite",
    "prebuild": "node scripts/build-exam-index.mjs && node scripts/check-lectures.mjs && node scripts/check-sql-puzzles.mjs && node scripts/check-games.mjs",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc -b",
    "exams": "node scripts/build-exam-index.mjs",
    "lectures": "node scripts/check-lectures.mjs",
    "sql-puzzles": "node scripts/check-sql-puzzles.mjs",
    "games": "node scripts/check-games.mjs",
    "android": "npm run build && cap sync android && cap open android",
    "android:sync": "npm run build && cap sync android"
  },
  "dependencies": {
    "@capacitor-community/text-to-speech": "^8.0.2",
    "@capacitor/android": "^8.5.3",
    "@capacitor/app": "^8.1.2",
    "@capacitor/browser": "^8.0.5",
    "@capacitor/core": "^8.5.3",
    "@capacitor/local-notifications": "^8.3.1",
    "@capacitor/status-bar": "^8.0.4",
    "@electric-sql/pglite": "0.5.10",
    "@lucide/vue": "^1.59.0",
    "@shikijs/markdown-it": "^4.5.0",
    "@supabase/supabase-js": "^2.118.0",
    "@vueuse/core": "^15.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.5.0",
    "markdown-it": "^15.0.2",
    "markdown-it-container": "^4.0.0",
    "mermaid": "^12.2.0",
    "minisearch": "^7.2.0",
    "pinia": "^4.1.0",
    "reka-ui": "^2.11.0",
    "shiki": "^4.5.0",
    "tailwind-merge": "^3.7.0",
    "vue": "^3.5.44",
    "vue-router": "^5.4.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.3",
    "@tailwindcss/vite": "^4.3.3",
    "@tsconfig/node22": "^22.0.6",
    "@types/markdown-it": "^14.2.0",
    "@types/markdown-it-container": "^4.0.1",
    "@types/node": "^26.6.5",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/tsconfig": "^0.9.1",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "~5.9",
    "vite": "^8.3.4",
    "vue-tsc": "^3.3.13"
  }
